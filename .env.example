# Copy this file to ".env" and fill in the values, then set email.enabled = true
# in config.json. Until then the report is only written to reports/.
#
# .env is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Option A - Gmail (simplest)
# ---------------------------------------------------------------------------
# A normal Gmail password will NOT work. You need an App Password:
#   1. Enable 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password:     https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below (spaces are fine, they get stripped).
#
# Sending to yourself from your own account is fine and needs no domain setup.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=your.address@gmail.com

# ---------------------------------------------------------------------------
# Option B - Brevo (formerly Sendinblue), 300 emails/day free
# ---------------------------------------------------------------------------
# Better inbox placement than Gmail SMTP if reports start landing in spam.
#
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM=your.address@gmail.com

# ---------------------------------------------------------------------------
# Option C - any other provider
# ---------------------------------------------------------------------------
# Port 465 is treated as implicit TLS; anything else uses STARTTLS.
