# Copy this file to ".env" and fill in what you need.
#
# .env is git-ignored and MUST stay that way: this repository is public.
# Nothing in here - address, domain, server, password - belongs in a
# committed file.

# ---------------------------------------------------------------------------
# Publishing to your own site
# ---------------------------------------------------------------------------
# Where the report archive is served from. Only used for the link printed at
# the end of a run, so you can click straight through.
PUBLISH_SITE_URL=https://example.com/your-path

# --- Running ON the web server (the normal setup) ---------------------------
# PUBLISH_DIR makes the scanner write straight into the directory nginx serves.
# Setting it also disables the upload step: you do not scp files to yourself.
# scripts/vps-setup.sh fills this in for you.
PUBLISH_DIR=

# --- Running somewhere else and uploading (optional) ------------------------
# Leave PUBLISH_DIR empty and fill these instead. Upload is by SSH key only -
# never a password, so an unattended run can never hang on a prompt.
#
# Set publish.upload.enabled = true in config.json once these are filled in.
VPS_HOST=
VPS_USER=
VPS_PATH=/var/www/house-hunter
VPS_PORT=22

# Path to the PRIVATE key that authenticates the upload. Generate a dedicated
# key for this rather than reusing your personal one:
#   ssh-keygen -t ed25519 -f ~/.ssh/house_finder -C "house-finder upload"
# then add the .pub half to the server user's ~/.ssh/authorized_keys.
VPS_SSH_KEY=

# NOTE: the password that protects the published page is NOT set here.
# It lives only on the web server, in an nginx htpasswd file - see
# docs/deployment.md. A password this program could read is a password that
# ends up in a log.

# ---------------------------------------------------------------------------
# Email (optional - the archive page replaces it, but it still works)
# ---------------------------------------------------------------------------
# Who receives the report. Deliberately not in config.json.
REPORT_EMAIL_TO=

# Gmail needs an App Password, not your normal password:
#   1. Enable 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password:     https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Alternative: Brevo (formerly Sendinblue), 300 emails/day free, better
# deliverability if reports start landing in spam.
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#
# Port 465 is treated as implicit TLS; anything else uses STARTTLS.
